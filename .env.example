# Copy to .env and adjust.

# Identify yourself honestly; many sites ask for a contact in the user agent.
USER_AGENT="VehicleScraper/1.0 (+contact: you@example.com)"

# Politeness
REQUEST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true

# Playwright for JavaScript-rendered pages (pip install playwright && playwright install chromium)
USE_BROWSER=false
BROWSER_HEADLESS=true

# Output
DATA_DIR=data
SAVE_RAW=false

# TuCarro = Mercado Libre official API (https://developers.mercadolibre.com)
ML_ACCESS_TOKEN=
ML_SITE_ID=MCO            # MCO = Colombia (tucarro.com.co), MLV = Venezuela (tucarro.com.ve)

# Knowledge base (PostgreSQL). The database is created by its owner; `kb migrate` only creates
# objects (schemas kb and staging). Needs: pip install -e .[kb]
OMNIBASE_DATABASE_URL=postgresql://user:password@localhost:5432/omnibase

# First portal editor (migration 0008_first_editor reads it once, when it runs). Kept out of the
# repository on purpose: the address only lives in your .env.
KB_FIRST_EDITOR_EMAIL=
KB_FIRST_EDITOR_NAME=
