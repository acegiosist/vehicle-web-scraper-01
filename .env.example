# Copy to .env and adjust.

# Identify yourself honestly; many sites ask for a contact in the user agent.
USER_AGENT="VehicleScraper/1.0 (+contact: you@example.com)"

# Politeness
REQUEST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RESPECT_ROBOTS_TXT=true

# Playwright for JavaScript-rendered pages (pip install playwright && playwright install chromium)
USE_BROWSER=false
BROWSER_HEADLESS=true

# Output
DATA_DIR=data
SAVE_RAW=false

# TuCarro = Mercado Libre official API (https://developers.mercadolibre.com)
ML_ACCESS_TOKEN=
ML_SITE_ID=MCO            # MCO = Colombia (tucarro.com.co), MLV = Venezuela (tucarro.com.ve)

# Knowledge base (PostgreSQL). Migrations: alembic upgrade head  (or: vehicle-scraper kb migrate)
KB_DATABASE_URL=postgresql://user:password@localhost:5432/vehicles_kb
# Claude Message Batches for `kb ai-identity` / `kb ai-specs` (only needed for --submit/--collect)
ANTHROPIC_API_KEY=
# Let the review website send batches to Claude (it costs money). `kb worker` re-reads it on every
# submission (no restart needed to switch it on or off); the site
# also needs KB_WEB_AI_SUBMIT=true in src/web/.env.local. Leave empty to keep sending CLI-only.
KB_ALLOW_WEB_AI_SUBMIT=
# Spending limit for Claude batches (USD), from the site and the CLI alike: a submission is refused
# when what was spent in the period plus its estimate exceeds it. Without it nothing is sent.
# Period: daily (default), weekly (from Monday) or monthly, in the worker's local time. Re-read on
# every submission; a run counts with its real cost once collected, its estimate until then.
KB_AI_BUDGET_USD=5
KB_AI_BUDGET_PERIOD=daily
