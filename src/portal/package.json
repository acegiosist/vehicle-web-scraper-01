{
  "name": "omnibase-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:types": "kysely-codegen --dialect postgres --env-file .env.local --url \"env(PORTAL_DATABASE_URL)\" --numeric-parser number --include-pattern \"{kb.*,staging.*}\" --out-file src/generated/db.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "kysely-codegen": "0.20.0",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@10.30.2",
  "description": "Portal de la base de conocimiento de vehículos (omnibase): revisar, explorar y corregir",
  "engines": {
    "node": ">=22.14"
  }
}
