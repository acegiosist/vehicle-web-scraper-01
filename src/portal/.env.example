# Copy to .env.local (never committed) and fill in.

# The portal's least-privilege role (docs/sql/portal_role.sql at the repository root): it reads
# kb/staging and can only INSERT requests into kb.web_action, which `kb worker` applies.
PORTAL_DATABASE_URL=postgresql://omnibase_portal:CHANGE_ME@localhost:5435/omnibase

# Identity. On GCP: iap, with the audience from IAP's "Signed Header JWT Audience".
#   PORTAL_AUTH=iap
#   PORTAL_IAP_AUDIENCE=/projects/123456789/locations/us-central1/services/omnibase-portal
# Locally, without IAP (refused in production and on Cloud Run). The role comes from kb.app_user:
PORTAL_AUTH=dev
PORTAL_DEV_USER=tu.correo@empresa.com
