# Copy to .env.local (never committed) and fill in.
# A least-privilege role: reads kb/staging, can only INSERT decisions and jobs.
# Create it once with docs/sql/review_web_role.sql, then run docs/sql/review_web_grants.sql
# (repository root) after every migration.
REVIEW_WEB_DATABASE_URL=postgresql://kb_review_web:CHANGE_ME@localhost:5435/carknowledge

# Show "Enviar a Claude" on an AI estimate (it costs money). The worker must ALSO have
# KB_ALLOW_WEB_AI_SUBMIT=true in the repository's .env, or it refuses the job.
KB_WEB_AI_SUBMIT=false
